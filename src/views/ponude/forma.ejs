<%- include('../partials/header') %>
<h1>Nova ponuda — <%= posao.naziv %></h1>
<p style="color:var(--text-muted); font-size:13px;">
  Sva polja ispod su opciona i mogu se dopuniti kasnije.
</p>

<form class="card" method="post" action="/poslovi/<%= posao.id %>/ponude">
  <% if (dostupniPlanovi.length) { %>
    <label>Koji plan(ove) sečenja koristi ova ponuda?</label>
    <div style="border:1px solid var(--border); border-radius:7px; padding:10px; margin-top:5px;">
      <% dostupniPlanovi.forEach(p => { %>
        <label style="display:flex; align-items:center; gap:8px; font-weight:400; margin-top:6px;">
          <input type="checkbox" name="planoviIds" value="<%= p.id %>" style="width:auto; margin:0;">
          <%= p.naziv_fajla || 'plan #' + p.id %> — <%= p.materijal || '' %> (<%= p.debljina_mm ?? '?' %>mm),
          težina <%= p.tezina_delova_kg ?? '?' %> kg
        </label>
      <% }) %>
    </div>
  <% } else { %>
    <p style="color:var(--text-muted); font-size:13px; border:1px dashed var(--border); border-radius:7px; padding:10px;">
      Nema dostupnih (nepovezanih) planova sečenja za ovaj posao. Ako posao ima sečenje, prvo ga
      uploaduj na stranici posla, ili nastavi bez njega — plan možeš povezati sa ovom ponudom i kasnije.
    </p>
  <% } %>

  <label>Primio (mesto)</label>
  <input type="text" name="primioMesto" value="<%= komitent.naziv %>">

  <label>Naslov posla</label>
  <input type="text" name="naslovPosla" value="<%= posao.naziv %>" placeholder="npr. Adaptacija metalne konstrukcije...">

  <label>Propratni tekst</label>
  <textarea name="propratniTekst" rows="3"></textarea>

  <label>Tehnički opis</label>
  <textarea name="tehnickiOpis" rows="3"></textarea>

  <label>Rok isporuke</label>
  <input type="text" name="rokIsporuke" placeholder="npr. 30 dana od dana uvođenja u posao">

  <label>Plaćanje</label>
  <input type="text" name="placanje" placeholder="npr. 60% avans ili po dogovoru">

  <label>Garancija</label>
  <input type="text" name="garancija" placeholder="npr. 2 godine na izvedene radove">

  <label>Napomena</label>
  <input type="text" name="napomena" placeholder="npr. Cene su bez PDV-a 20%">

  <label>Rok važenja ponude</label>
  <input type="text" name="rokVazenja" placeholder="npr. 20 dana">

  <button type="submit">Kreiraj ponudu</button>
</form>

<%- include('../partials/footer') %>
