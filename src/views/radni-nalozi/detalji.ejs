<%- include('../partials/header') %>

<div class="page-head">
  <h1>Radni nalog br. <%= nalog.broj %></h1>
  <% if (typeof korisnik !== 'undefined' && korisnik && korisnik.uloga === 'administrator') { %>
    <form method="post" action="/radni-nalozi/<%= nalog.id %>/obrisi"
          onsubmit="return confirm('OBRISATI radni nalog <%= nalog.broj %>?\n\nOvo trajno briše:\n- <%= uticajBrisanja.brojStavki %> stavki (ukupno dodeljeno <%= uticajBrisanja.ukupnoDodeljeno %> kom., realizovano <%= uticajBrisanja.ukupnoRealizovano %> kom.)\n\nDodeljene količine se oslobađaju — moći će ponovo da se rasporede na novom nalogu.\n\nOVO SE NE MOŽE PONIŠTITI. Nastaviti?');">
      <button type="submit" style="background:var(--danger); margin:0;">Obriši radni nalog</button>
    </form>
  <% } %>
</div>
<p><strong>Posao:</strong> <a href="/poslovi/<%= posao.id %>"><%= posao.naziv %></a></p>

<div class="card">
  <p><strong>Status:</strong>
    <%= { otvoren: 'Otvoren', u_izradi: 'U izradi', zavrsen: 'Završen', storniran: 'Storniran' }[nalog.status] %>
  </p>
  <form method="post" action="/radni-nalozi/<%= nalog.id %>/status">
    <select name="status" onchange="this.form.submit()">
      <option value="otvoren" <%= nalog.status==='otvoren'?'selected':'' %>>Otvoren</option>
      <option value="u_izradi" <%= nalog.status==='u_izradi'?'selected':'' %>>U izradi</option>
      <option value="zavrsen" <%= nalog.status==='zavrsen'?'selected':'' %>>Završen</option>
      <option value="storniran" <%= nalog.status==='storniran'?'selected':'' %>>Storniran</option>
    </select>
  </form>
</div>

<div class="card">
  <h2 style="font-size:16px;">Stavke naloga</h2>
  <table>
    <thead><tr><th>Deo</th><th>Dodeljeno</th><th>Realizovano</th><th></th></tr></thead>
    <tbody>
      <% stavke.forEach(s => { %>
        <tr>
          <td><%= s.part_name %></td>
          <td><%= s.kolicina_dodeljena %></td>
          <td><%= s.kolicina_zavrsena %></td>
          <td>
            <form method="post" action="/radni-nalozi/<%= nalog.id %>/stavke/<%= s.id %>/realizacija" style="display:flex; gap:6px; margin:0;">
              <input type="number" name="kolicinaZavrsena" min="0" max="<%= s.kolicina_dodeljena %>" value="<%= s.kolicina_zavrsena %>" style="width:80px;">
              <button type="submit" style="margin:0;">Ažuriraj</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<a class="btn" href="/radni-nalozi/<%= nalog.id %>/pdf">Preuzmi PDF (za štampu)</a>

<%- include('../partials/footer') %>
