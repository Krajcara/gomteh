<%- include('../partials/header') %>

<h1><%= komitent.naziv %></h1>

<div class="card">
  <p><strong>Tip:</strong> <%= komitent.tip === 'firma' ? 'Firma' : 'Fizičko lice' %></p>
  <p><strong>Adresa:</strong> <%= komitent.adresa || '—' %></p>
  <p><strong>Mesto:</strong> <%= komitent.mesto || '—' %></p>
  <% if (komitent.tip === 'firma') { %>
    <p><strong>Kontakt osoba:</strong> <%= komitent.kontakt_osoba || '—' %></p>
    <p><strong>PIB:</strong> <%= komitent.pib || '—' %></p>
  <% } %>
  <p><strong>Telefon:</strong> <%= komitent.kontakt_telefon || '—' %></p>
  <p><strong>Email (portal):</strong> <%= komitent.email || '—' %></p>
  <a class="btn" href="/komitenti/<%= komitent.id %>/izmeni">Izmeni podatke</a>
  <% if (komitent.email) { %>
    <form method="post" action="/komitenti/<%= komitent.id %>/reset-lozinka" style="margin-top:16px; border-top:1px solid var(--border); padding-top:16px;">
      <label>Nova lozinka za portal (ostavi prazno za automatski generisanu)</label>
      <input type="text" name="novaLozinka" placeholder="npr. jednostavna lozinka po dogovoru sa klijentom" style="max-width:320px;">
      <button type="submit" onclick="return confirm('Postaviti novu lozinku za portal ovog komitenta? Stara lozinka prestaje da važi.');">
        Resetuj lozinku za portal
      </button>
    </form>
  <% } %>
</div>

<div class="card">
  <h2 style="font-size:16px;">Poslovi</h2>
  <a class="btn" href="/komitenti/<%= komitent.id %>/poslovi/novi">+ Novi posao</a>

  <table style="margin-top:14px;">
    <thead><tr><th>Naziv</th><th>Status</th><th>Kreiran</th></tr></thead>
    <tbody>
      <% poslovi.forEach(p => { %>
        <tr onclick="location.href='/poslovi/<%= p.id %>'">
          <td><%= p.naziv %></td>
          <td>
            <span class="badge badge-<%= p.status %>">
              <%= { poslata_ponuda: 'Poslata ponuda', u_izradi: 'U izradi', zavrsen: 'Završen', odbijen: 'Odbijen' }[p.status] %>
            </span>
          </td>
          <td><%= new Date(p.kreiran_at).toLocaleDateString('sr-RS') %></td>
        </tr>
      <% }) %>
      <% if (!poslovi.length) { %><tr><td colspan="3">Nema poslova.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
