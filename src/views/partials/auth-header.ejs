<!DOCTYPE html>
<html lang="sr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GOMTEH</title>
  <link rel="stylesheet" href="/public/css/style.css">
  <script>
    (function () {
      const sacuvana = localStorage.getItem('gomteh-tema');
      document.documentElement.setAttribute('data-tema', sacuvana || 'dark');
    })();
  </script>
</head>
<body class="auth-body">
  <button class="theme-toggle theme-toggle-floating" onclick="prebaciTemu()" title="Promeni temu" aria-label="Promeni temu">
    <span class="icon-sun">☀</span><span class="icon-moon">☾</span>
  </button>
  <div class="auth-wrap">
    <div class="auth-brand"><span class="brand-mark">G</span> GOMTEH</div>
