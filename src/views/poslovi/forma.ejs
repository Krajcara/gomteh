<%- include('../partials/header') %>
<h1>Novi posao — <%= komitent.naziv %></h1>
<form class="card" method="post" action="/komitenti/<%= komitent.id %>/poslovi">
  <label>Naziv posla</label>
  <input type="text" name="naziv" value="<%= predlogNaziva %>">
  <button type="submit">Otvori posao</button>
  <a href="/komitenti/<%= komitent.id %>" class="btn" style="background:var(--bg-elevated-2); color:var(--text);">Otkaži</a>
</form>
<%- include('../partials/footer') %>
