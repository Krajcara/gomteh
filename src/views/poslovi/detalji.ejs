<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= posao.naziv %></h1>
  <% if (typeof korisnik !== 'undefined' && korisnik && korisnik.uloga === 'administrator') { %>
    <form method="post" action="/poslovi/<%= posao.id %>/obrisi"
          onsubmit="return confirm('OBRISATI POSAO \'<%= posao.naziv %>\'?\n\nOvo trajno briše:\n- <%= uticajBrisanja.brojPonuda %> ponuda\n- <%= uticajBrisanja.brojNaloga %> radnih naloga\n- <%= uticajBrisanja.brojPlanova %> planova sečenja\n- <%= uticajBrisanja.brojUplata %> uplata (ukupno <%= uticajBrisanja.ukupnoUplata.toLocaleString('sr-RS') %> din)\n\nOVO SE NE MOŽE PONIŠTITI. Nastaviti?');">
      <button type="submit" style="background:var(--danger); margin:0;">Obriši posao</button>
    </form>
  <% } %>
</div>
<p><strong>Komitent:</strong> <a href="/komitenti/<%= komitent.id %>"><%= komitent.naziv %></a></p>

<div class="card">
  <p><strong>Status posla:</strong>
    <span class="badge badge-<%= posao.status %>">
      <%= { poslata_ponuda: 'Poslata ponuda', u_izradi: 'U izradi', zavrsen: 'Završen', odbijen: 'Odbijen' }[posao.status] %>
    </span>
  </p>
  <form method="post" action="/poslovi/<%= posao.id %>/status" style="display:inline;">
    <select name="status" onchange="this.form.submit()">
      <option value="poslata_ponuda" <%= posao.status==='poslata_ponuda'?'selected':'' %>>Poslata ponuda</option>
      <option value="u_izradi" <%= posao.status==='u_izradi'?'selected':'' %>>U izradi</option>
      <option value="zavrsen" <%= posao.status==='zavrsen'?'selected':'' %>>Završen</option>
      <option value="odbijen" <%= posao.status==='odbijen'?'selected':'' %>>Odbijen</option>
    </select>
  </form>
</div>

<div class="card">
  <h2 style="font-size:16px;">Planovi sečenja</h2>
  <p style="color:var(--text-muted); font-size:13px; margin-top:-8px;">
    Uploaduj jedan ili više planova sečenja (PDF) za ovaj posao. Kad budeš pravio ponudu, birаćeš koji od njih da koristiš.
  </p>

  <form method="post" action="/poslovi/<%= posao.id %>/planovi" enctype="multipart/form-data">
    <input type="file" name="plan" accept=".pdf" required>
    <button type="submit">Uploaduj plan</button>
  </form>

  <table style="margin-top:14px;">
    <thead><tr><th>Fajl</th><th>Materijal</th><th>Težina (kg)</th><th>Dužina reza (mm)</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% planovi.forEach(p => { %>
        <tr>
          <td><%= p.naziv_fajla || '—' %></td>
          <td><%= p.materijal || '—' %> (<%= p.debljina_mm ?? '—' %>mm)</td>
          <td><%= p.tezina_delova_kg ?? '—' %></td>
          <td><%= p.duzina_reza_mm ?? '—' %></td>
          <td>
            <% if (p.ponuda_id) { %>
              povezan sa ponudom <a href="/ponude/<%= p.ponuda_id %>"><%= ponudeMape[p.ponuda_id] || p.ponuda_id %></a>
            <% } else { %>
              <span style="color:var(--text-muted);">dostupan (nije povezan)</span>
            <% } %>
          </td>
          <td>
            <% if (p.preveden_fajl_putanja) { %>
              <a href="/poslovi/<%= posao.id %>/planovi/<%= p.id %>/preuzmi">Preuzmi prevod</a>
            <% } %>
            <% if (typeof korisnik !== 'undefined' && korisnik && korisnik.uloga === 'administrator') { %>
              <form method="post" action="/poslovi/<%= posao.id %>/planovi/<%= p.id %>/obrisi" style="display:inline; margin-left:8px;"
                    onsubmit="return confirm('Obrisati plan sečenja \'<%= p.naziv_fajla %>\'?\n\nOvo se ne može poništiti. Ako je povezan sa ponudom, veza se uklanja ali dodate stavke cene ostaju.');">
                <button type="submit" style="background:var(--danger); margin:0; padding:4px 8px; font-size:12px;">Obriši</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!planovi.length) { %><tr><td colspan="6">Nema uploadovanih planova.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2 style="font-size:16px;">Ponude</h2>
  <p style="color:var(--text-muted); font-size:13px; margin-top:-8px;">
    Klikni "Nova ponuda" — na sledećoj stranici bira šta se od uploadovanih planova sečenja koristi i dodaješ stavke cene.
  </p>
  <a class="btn" href="/poslovi/<%= posao.id %>/ponude/nova">+ Nova ponuda</a>
  <table>
    <thead><tr><th>Broj</th><th>Naslov</th><th>Status</th><th>Ukupno</th></tr></thead>
    <tbody>
      <% ponude.forEach(p => { %>
        <tr onclick="location.href='/ponude/<%= p.id %>'" style="cursor:pointer;">
          <td><%= p.broj %></td>
          <td><%= p.naslov_posla || '' %></td>
          <td><span class="badge badge-<%= p.status %>"><%= { poslata: 'Poslata', prihvacena: 'Prihvaćena', odbijena: 'Odbijena' }[p.status] %></span></td>
          <td><%= p.ukupno ? p.ukupno.toLocaleString('sr-RS') + ' din' : '—' %></td>
        </tr>
      <% }) %>
      <% if (!ponude.length) { %><tr><td colspan="4">Nema ponuda.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2 style="font-size:16px;">Radni nalozi</h2>
  <a class="btn" href="/poslovi/<%= posao.id %>/radni-nalozi/novi">+ Novi radni nalog</a>
  <table>
    <thead><tr><th>Broj</th><th>Status</th><th>Datum</th></tr></thead>
    <tbody>
      <% radniNalozi.forEach(n => { %>
        <tr onclick="location.href='/radni-nalozi/<%= n.id %>'" style="cursor:pointer;">
          <td><%= n.broj %></td>
          <td><span class="badge badge-<%= n.status %>"><%= { otvoren: 'Otvoren', u_izradi: 'U izradi', zavrsen: 'Završen', storniran: 'Storniran' }[n.status] %></span></td>
          <td><%= new Date(n.datum).toLocaleDateString('sr-RS') %></td>
        </tr>
      <% }) %>
      <% if (!radniNalozi.length) { %><tr><td colspan="3">Nema radnih naloga.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
