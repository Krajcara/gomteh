<%- include('../partials/header') %>
<h1><%= typeof jeReset !== 'undefined' && jeReset ? 'Lozinka resetovana' : 'Korisnik kreiran' %></h1>

<div class="card" style="max-width:460px;">
  <p><strong><%= korisnik.ime %></strong> (<%= korisnik.email %>)</p>
  <p style="color:var(--warning); font-weight:600;">Zapiši ovu lozinku odmah — neće biti ponovo prikazana:</p>
  <p style="font-size:20px; font-family:monospace; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:12px; text-align:center;">
    <%= inicijalnaLozinka %>
  </p>
  <p style="color:var(--text-muted); font-size:13px;">Korisnik će morati da je promeni pri sledećem logovanju.</p>
  <a class="btn" href="/korisnici/<%= korisnik.id %>">Nazad na korisnika</a>
</div>

<%- include('../partials/footer') %>
