# Ovaj fajl je samo primer/dokumentacija.
# Stvarni .env se generiše automatski pokretanjem install.sh — ne pravi ga ručno
# i nikad ga ne dodaji u git (već je u .gitignore).

DB_PATH=./data/gomteh.db
DB_ENCRYPTION_KEY=generise_se_automatski_pri_instalaciji
SESSION_SECRET=generise_se_automatski_pri_instalaciji
PORT=3000

# ── Prijava preko Keycloak-a (opciono) ──────────────────────────────────────
# Ako je OIDC_ISSUER prazan, prikazuje se samo prijava emailom i lozinkom.
# Lokalna prijava ostaje dostupna i kad je Keycloak uključen (rezerva).
OIDC_ISSUER=https://auth.krajcara.com/realms/homelab
OIDC_CLIENT_ID=gomteh
OIDC_CLIENT_SECRET=iz_keycloak_clients_gomteh_credentials
OIDC_REDIRECT_URI=https://gomteh.krajcara.com/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://gomteh.krajcara.com/prijava
# Naziv claima sa ulogama (mapper u Keycloak-u); podrazumevano gomteh_roles
# OIDC_ROLES_CLAIM=gomteh_roles
